# Copy to deploy/.env and adjust. Every value has a development default in docker-compose.yml.
POSTGRES_PASSWORD=measurehub
MH_SECRET_KEY=change-me-to-a-long-random-string
MH_BOOTSTRAP_USERNAME=operator
MH_BOOTSTRAP_PASSWORD=change-me
WORKER_CONCURRENCY=2

# Watchdog (re-queues jobs of dead workers) and instrument polling, seconds
MH_WATCHDOG_INTERVAL_S=30
MH_WATCHDOG_STALE_S=60
MH_POLL_INTERVAL_S=60

# Simulated sample (see `measurehub-sim --help`)
MH_SIM_EPS=10,0.5
MH_SIM_MU=1.5,0.2
MH_SIM_THICKNESS_MM=3

# Simulator faults: probability per received line, extra latency in ms
MH_SIM_FAULT_DROP=0
MH_SIM_FAULT_HANG=0
MH_SIM_FAULT_ERR=0
MH_SIM_FAULT_LATENCY_MS=0
